# Variáveis de Ambiente - Sistema Pós-Contato
# Copie este arquivo para .env e configure os valores

# Porta do servidor (padrão: 3000)
PORT=3000

# Chave secreta para JWT (OBRIGATÓRIO)
# Em produção, use uma chave forte e aleatória
# Exemplo de chave forte: openssl rand -base64 32
JWT_SECRET=minha-chave-secreta-super-forte-2026

# Ambiente de execução
NODE_ENV=development

# URL do banco de dados PostgreSQL (opcional)
# Se não definido, usa SQLite local (database.db)
# DATABASE_URL=postgresql://usuario:senha@host:5432/database
